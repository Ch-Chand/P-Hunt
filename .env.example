# No environment file or API key is required for P0/P1.
# All VITE_ values are public browser configuration, never secrets.
VITE_APP_MODE=demo
# Use / for localhost or a root/custom-domain site; /REPOSITORY/ for a project site.
# The GitHub Pages workflow computes this automatically unless its repository variable overrides it.
VITE_BASE_PATH=/

# Reserved for P2. No Supabase client or authentication is activated in P0/P1.
# Leave empty. Never put a Supabase service-role key, secret key or provider token here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

